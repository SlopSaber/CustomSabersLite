        </Reference>
        <Reference Include="ZenjectExtension">
          <HintPath>$(GameDirectory)\Beat Saber_Data\Managed\ZenjectExtension.dll</HintPath>
          <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
